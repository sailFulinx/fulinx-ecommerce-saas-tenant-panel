# 环境
NODE_ENV=development

# 打包路径
VITE_BASE_PATH=/

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=true

# 输出路径
VITE_OUT_DIR=dist-test

# 标题
VITE_APP_TITLE=Fulinx

# API URL
# VITE_API_URL=http://localhost:17010/api/

# # 资源URL
# VITE_RESOURCE_URL=http://image.fulinxcms.com

# API URL
VITE_API_URL=https://test.api.tanpoqiuer.com/api/

# 资源URL
VITE_RESOURCE_URL=https://test.image.tanpoqiuer.com
